{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ningbainb/deepseek-harness-desktop/blob/main/docs/schemas/runtime-provider-v2.schema.json",
  "title": "DeepSeek Harness Desktop Runtime Provider v2",
  "$comment": "Capability negotiation for the private Desktop Runtime boundary. Unknown additive fields remain compatible.",
  "type": "object",
  "additionalProperties": true,
  "required": ["providerId", "apiVersion", "upstreamVersion", "supportStatus", "capabilities"],
  "properties": {
    "providerId": { "const": "dsh-cli-provider-v1" },
    "apiVersion": { "const": 2 },
    "upstreamVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "supportStatus": {
      "enum": ["known-good", "supported", "candidate", "blocked", "degraded", "unsupported"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "enum": [
            "runtime.lifecycle",
            "profile.paths",
            "workspace.register",
            "session.create",
            "session.observe",
            "host-service.register",
            "transport.fetch",
            "transport.stream",
            "runtime.observe",
            "support.evidence"
          ]
        },
        "status": { "enum": ["available", "unavailable", "unsupported"] }
      }
    }
  }
}
